rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /voice-messages/{fileName} {

      allow read: if true;

      allow write: if
        request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      allow delete: if false;
    }
  }
}